<html>
	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
		<link href="https://fonts.cdnfonts.com/css/open-sauce-one" rel="stylesheet">
	</head>
	<body style="margin: 0; padding: 0; font-family: 'Open Sauce One', Roboto, sans-serif;">
		<table border="0" cellpadding="0" cellspacing="0">
			<tr>
				<td align="center" valign="middle">
					<table border="0" cellpadding="0" cellspacing="0" width="600" style="height: 425px; padding: 48px 32px 32px 32px; border-radius: 16px; border: 1px solid #F2F2F2; background: #FFF; box-shadow: 0px 6px 24px 0px rgba(49, 74, 92, 0.08);">
						<tr>
							<td align="center" style="padding-bottom:24px;">
								<img src="http://cdn.mcauto-images-production.sendgrid.net/6a47f820b604f688/397a3da0-435f-4d27-9ebe-fa08501ce10c/150x40.png" alt="String Logo" width="150" height="40">
							</td>
						</tr>
						<tr>
							<td align="center" style="color: #002F5B; text-align: center; font-size: 24px; font-weight: 500; line-height: 32px; padding-bottom:24px;">
								You have been invited to {{.orgName}} on the String Dashboard
							</td>
						</tr>
						<tr>
							<td style="color: #0C1116; padding-bottom:24px;">
								<p style="margin-bottom: 16px;">
									Dear {{.userName}},
								</p>
								<p>
									Please click the button below to set your password and complete your registration process.
								</p>
							</td>
						</tr>
						<tr>
							<td style="width: 100%; padding-bottom:24px;">
								<a href="{{.link}}" style="display: block; height: 30px; line-height: 30px; padding: 10px 32px; background: #F92572; border-radius: 40px; color: white; font-size: 16px; text-decoration: none; text-align: center;">Accept Invitation</a>
							</td>
						</tr>
						<tr>
							<td style="color: #3C5370; padding-bottom:24px;">
								If you do not recognize this organization, please disregard this email.
							</td>
						</tr>
						<tr>
							<td style="border-bottom: 1px solid #ECEEF1;"></td>
						</tr>
						<tr>
							<td align="center" style="padding-top:24px;">
								<table width="100%">
									<tr>
										<td align="center">
											<p style="display: inline-block; margin: 0; margin-right: 8px; font-weight: 500px; color: #8A98A9;">Powered by</p>
											<img style="display: inline-block; vertical-align: middle;" src="http://cdn.mcauto-images-production.sendgrid.net/6a47f820b604f688/397a3da0-435f-4d27-9ebe-fa08501ce10c/150x40.png" alt="String Logo" width="80" height="24">
										</td>
									</tr>
								</table>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
